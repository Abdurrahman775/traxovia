[Unit]
Description=MT5 Bridge Server (Wine Python)
After=network.target xvfb.service
Requires=xvfb.service

[Service]
Type=simple
User=kira
Environment=DISPLAY=:99
WorkingDirectory=/home/kira/trading-bot
ExecStartPre=/bin/sleep 15
ExecStart=/home/kira/trading-bot/mt5_bridge/start_bridge.sh
Restart=always
RestartSec=15
StandardOutput=append:/home/kira/trading-bot/logs/mt5_bridge.log
StandardError=append:/home/kira/trading-bot/logs/mt5_bridge.log

[Install]
WantedBy=multi-user.target
