[Unit]
Description=Traxovia Celery Worker
After=network.target redis.service postgresql.service
Wants=redis.service

[Service]
Type=forking
User=kira
WorkingDirectory=/home/kira/projects/trading-bot
EnvironmentFile=/home/kira/projects/trading-bot/.env
ExecStart=/home/kira/projects/trading-bot/venv/bin/celery \
    -A scheduler.tasks worker \
    --pool=solo \
    --loglevel=info \
    --logfile=/tmp/traxovia/celery_worker.log \
    --pidfile=/tmp/traxovia/celery_worker.pid \
    --detach
ExecStop=/bin/kill -TERM $MAINPID
PIDFile=/tmp/traxovia/celery_worker.pid
RuntimeDirectory=traxovia
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
