[Unit]
Description=Traxovia Celery Beat Scheduler
After=network.target redis.service traxovia-worker.service
Wants=redis.service
BindsTo=traxovia-worker.service

[Service]
Type=forking
User=kira
WorkingDirectory=/home/kira/projects/trading-bot
EnvironmentFile=/home/kira/projects/trading-bot/.env
ExecStart=/home/kira/projects/trading-bot/venv/bin/celery \
    -A scheduler.tasks beat \
    --loglevel=info \
    --logfile=/tmp/traxovia/celery_beat.log \
    --pidfile=/tmp/traxovia/celery_beat.pid \
    --detach
ExecStop=/bin/kill -TERM $MAINPID
PIDFile=/tmp/traxovia/celery_beat.pid
RuntimeDirectory=traxovia
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
