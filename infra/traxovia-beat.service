[Unit]
Description=Traxovia Celery Beat Scheduler
After=network.target redis.service traxovia-worker.service
Wants=redis.service

[Service]
Type=simple
User=kira
WorkingDirectory=/home/kira/projects/traxovia
EnvironmentFile=/home/kira/projects/traxovia/.env
ExecStart=/home/kira/projects/traxovia/venv/bin/celery \
    -A scheduler.tasks beat \
    --loglevel=info
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
